#!/bin/bash
set -u

self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self") || exit 1
  if [[ "$target" = /* ]]; then
    self=$target
  else
    self=$(dirname "$self")/$target
  fi
done

self=$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self")

local_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -x "$local_hook" ] && [ ! "$local_hook" -ef "$self" ]; then
  "$local_hook" "$@" || exit $?
fi

launcher="stanza pre-commit hook"
source "$(dirname "$self")/../launch.sh"

exec "${stanza[@]}" --check --staged ${STANZA_FLAGS-}
