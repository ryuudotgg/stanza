#!/bin/bash
set -u

self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
local_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$local_hook" ] && [ "$(cd "$(dirname "$local_hook")" && pwd)/pre-commit" != "$self" ]; then
  "$local_hook" "$@" || exit $?
fi

stanza_root="$(cd "$(dirname "$self")/.." && pwd)"
if command -v bun >/dev/null 2>&1 && [ -d "$stanza_root/node_modules/oxc-parser" ]; then
  stanza=(bun run "$stanza_root/src/cli.ts")
elif [ -x "$stanza_root/bin/stanza" ]; then
  stanza=("$stanza_root/bin/stanza")
else
  echo "stanza pre-commit hook: neither $stanza_root/bin/stanza nor bun with installed dependencies is available; run 'bun install' or 'bun run build' in $stanza_root, or remove the hook" >&2
  exit 1
fi

exec "${stanza[@]}" --check --staged ${STANZA_FLAGS-}
