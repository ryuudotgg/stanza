#!/bin/bash
set -u

self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
local_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$local_hook" ] && [ "$(cd "$(dirname "$local_hook")" && pwd)/pre-commit" != "$self" ]; then
  "$local_hook" "$@" || exit $?
fi

stanza_root="$(cd "$(dirname "$self")/.." && pwd)"
if command -v bun >/dev/null 2>&1; then
  stanza=(bun run "$stanza_root/src/cli.ts")
elif [ -x "$stanza_root/bin/stanza" ]; then
  stanza=("$stanza_root/bin/stanza")
else
  echo "stanza pre-commit hook: neither $stanza_root/bin/stanza nor bun is available; run 'bun run build' in $stanza_root or remove the hook" >&2
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -E '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs)$' || true)
[ -z "$staged" ] && exit 0

root=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/stanza-staged.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

printf '%s\n' "$staged" | tr '\n' '\0' | git checkout-index -z --prefix="$tmp/" --stdin

cd "$tmp" && printf '%s\n' "$staged" | tr '\n' '\0' | STANZA_CONFIG_ROOT="$root" xargs -0 "${stanza[@]}" --check ${STANZA_FLAGS-}
