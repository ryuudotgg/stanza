#!/bin/bash
set -u

self=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
local_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -x "$local_hook" ] && [ "$(cd "$(dirname "$local_hook")" && pwd -P)/pre-commit" != "$self" ]; then
  "$local_hook" "$@" || exit $?
fi

launcher="stanza pre-commit hook"
source "$(dirname "$self")/../launch.sh"

flags=()
for flag in ${STANZA_FLAGS-}; do
  [ "$flag" = "--hunks" ] || flags+=("$flag")
done

exec "${stanza[@]}" --check --staged ${flags[@]+"${flags[@]}"}
