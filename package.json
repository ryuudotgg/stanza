{
  "name": "@ryuugg/stanza",
  "version": "0.1.0",
  "description": "An opinionated code formatter for TypeScript and JavaScript",
  "keywords": [
    "formatter",
    "typescript",
    "javascript",
    "blank-lines",
    "braces",
    "oxc",
    "claude-code",
    "codex",
    "hooks"
  ],
  "homepage": "https://github.com/ryuudotgg/stanza#readme",
  "bugs": {
    "url": "https://github.com/ryuudotgg/stanza/issues"
  },
  "license": "MIT",
  "author": "Ryuu (https://github.com/ryuudotgg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuudotgg/stanza.git"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "stanza": "src/cli.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "bench": "bun scripts/bench.ts",
    "build": "bun scripts/build.ts",
    "check": "oxlint && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt",
    "compare": "bun scripts/compare-commit.ts",
    "self-check": "bun run src/cli.ts --check src scripts tests/*.ts",
    "test": "bun test --parallel",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oxc-parser": "^0.151.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "5"
  },
  "publishConfig": {
    "access": "public"
  }
}
