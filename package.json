{
  "name": "@ryuugg/stanza",
  "version": "0.3.3",
  "description": "An opinionated code formatter for TypeScript.",
  "keywords": [
    "formatter",
    "code-formatter",
    "code-style",
    "typescript",
    "javascript",
    "oxc",
    "claude-code",
    "codex",
    "ai-agents"
  ],
  "homepage": "https://stanza.ryuu.gg",
  "bugs": {
    "url": "https://github.com/ryuudotgg/stanza/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuudotgg/stanza.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ryuu",
    "url": "https://ryuu.gg"
  },
  "type": "module",
  "bin": {
    "stanza": "src/launcher"
  },
  "files": [
    "src/launcher"
  ],
  "workspaces": [
    "docs",
    "npm/*"
  ],
  "scripts": {
    "bench": "bun scripts/bench.ts",
    "check": "oxlint --disable-nested-config && oxfmt --disable-nested-config --check",
    "check:fix": "oxlint --disable-nested-config --fix && oxfmt --disable-nested-config",
    "self-check": "target/release/stanza --check scripts tests/*.ts docs",
    "tegami": "bun scripts/tegami.ts",
    "test": "bun test --parallel",
    "typecheck": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@ryuugg/stanza-darwin-arm64": "0.3.3",
    "@ryuugg/stanza-darwin-x64": "0.3.3",
    "@ryuugg/stanza-linux-arm64": "0.3.3",
    "@ryuugg/stanza-linux-arm64-musl": "0.3.3",
    "@ryuugg/stanza-linux-x64": "0.3.3",
    "@ryuugg/stanza-linux-x64-musl": "0.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "latest",
    "oxc-parser": "0.151.0",
    "oxfmt": "0.70.0",
    "oxlint": "^1.85.0",
    "prettier": "3.9.10",
    "tegami": "^1.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
