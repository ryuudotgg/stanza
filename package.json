{
  "name": "@ryuugg/stanza",
  "version": "0.3.1",
  "description": "An opinionated code formatter for TypeScript.",
  "keywords": [
    "formatter",
    "code-formatter",
    "code-style",
    "typescript",
    "javascript",
    "oxc",
    "claude-code",
    "codex",
    "ai-agents"
  ],
  "homepage": "https://stanza.ryuu.gg",
  "bugs": {
    "url": "https://github.com/ryuudotgg/stanza/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuudotgg/stanza.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ryuu",
    "url": "https://ryuu.gg"
  },
  "type": "module",
  "bin": {
    "stanza": "src/launcher"
  },
  "files": [
    "src"
  ],
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "bench": "bun scripts/bench.ts",
    "build": "bun scripts/build.ts",
    "check": "oxlint && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt",
    "self-check": "bun run src/cli.ts --check src scripts tests/*.ts",
    "tegami": "bun scripts/tegami.ts",
    "test": "bun test --parallel",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oxc-parser": "^0.151.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tegami": "^1.5.0",
    "typescript": "5"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
