#!/bin/sh
':' /*
# Runs as sh first and execs the binary where npm, pnpm and Bun install it, so no JavaScript runtime starts.
self=$0
for package in "${self%/.bin/stanza}/@ryuugg/stanza" "${self%/bin/stanza}/lib/node_modules/@ryuugg/stanza" "${self%/bin/stanza}/install/global/node_modules/@ryuugg/stanza"; do
  [ "$self" -ef "$package/src/launcher" ] 2>/dev/null && break
  package=
done

if [ -z "$package" ]; then
  while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
      /*) self=$link ;;
      *) self=${self%/*}/$link ;;
    esac
  done

  case $self in
    *"/"*) package=${self%/*}/.. ;;
    *) package=.. ;;
  esac
fi

present() {
  for file in "$@"; do
    [ -e "$file" ] && return 0
  done

  return 1
}

machine=
if present /System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e /System/Library/dyld/dyld_shared_cache_arm64e; then
  machine="Darwin arm64"
elif present /lib64/ld-linux-x86-64.so.2 /lib/ld-musl-x86_64.so.1; then
  present /lib/ld-linux-aarch64.so.1 /lib/ld-musl-aarch64.so.1 || machine="Linux x86_64"
elif present /lib/ld-linux-aarch64.so.1 /lib/ld-musl-aarch64.so.1; then
  machine="Linux aarch64"
fi

[ -n "$machine" ] || machine=$(uname -sm 2>/dev/null)

musl= rosetta=
case $machine in
  "Darwin arm64") platform=darwin-arm64 rosetta=darwin-x64 ;;
  "Darwin x86_64") platform=darwin-x64 ;;
  "Linux aarch64") platform=linux-arm64 musl=/lib/ld-musl-aarch64.so.1 ;;
  "Linux x86_64") platform=linux-x64 musl=/lib/ld-musl-x86_64.so.1 ;;
  *) platform= ;;
esac

if [ -n "$platform" ]; then
  if [ -n "$musl" ] && [ -e "$musl" ]; then
    order="$platform-musl $platform"
  elif [ -n "$musl" ]; then
    order="$platform $platform-musl"
  else
    order="$platform $rosetta"
  fi

  for scope in "$package/node_modules/@ryuugg" "$package/.."; do
    for candidate in $order; do
      if [ -x "$scope/stanza-$candidate/stanza" ]; then
        exec "$scope/stanza-$candidate/stanza" "$@"
      fi
    done
  done
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$0" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$0" "$@"
fi

echo 'stanza: needs Node.js or Bun to start, or a release binary (https://github.com/ryuudotgg/stanza/releases/latest)' >&2
[ "$1" = hook ] && exit 1
exit 2
*/

// Parses as CommonJS and as an ES module, since Node picks the format of an extensionless file by version.
const args = process.argv.slice(2);
const failure = args[0] === "hook" ? 1 : 2;
const releases = "https://github.com/ryuudotgg/stanza/releases/latest";

function fail(message) {
  process.stderr.write(`stanza: ${message}\n`);
  process.exit(failure);
}

function candidates(fs) {
  const host = `${process.platform}-${process.arch}`;
  if (host === "darwin-arm64") return [host, "darwin-x64"];
  if (process.platform !== "linux") return [host];

  const loader = `/lib/ld-musl-${process.arch === "x64" ? "x86_64" : "aarch64"}.so.1`;
  const musl = fs.existsSync(loader);
  return musl ? [`${host}-musl`, host] : [host, `${host}-musl`];
}

function locate(fs, path, require) {
  const platforms = candidates(fs);
  for (const platform of platforms)
    try {
      const name = `@ryuugg/stanza-${platform}`;
      const manifest = require.resolve(`${name}/package.json`);
      return { name, binary: path.join(path.dirname(manifest), "stanza") };
    } catch {}

  fail(
    `no binary package for ${platforms[0]}: install @ryuugg/stanza-${platforms[0]}, or download stanza-${platforms[0]} from ${releases}`,
  );
}

function run({ name, binary }, spawn, util) {
  let child;
  const forward = (signal) => child.kill(signal);
  const signals = ["SIGINT", "SIGHUP", "SIGTERM"];
  for (const signal of signals) process.on(signal, forward);

  child = spawn(binary, args, { stdio: "inherit" });

  child.on("error", (error) => {
    const { errno } = error;
    const reason =
      typeof errno === "number"
        ? (util.getSystemErrorMap().get(errno)?.[1] ?? util.getSystemErrorName(errno))
        : error.message;

    fail(`cannot start ${name}: ${reason.charAt(0).toLowerCase()}${reason.slice(1)}`);
  });
  child.on("exit", (code, signal) => {
    if (signal === null) process.exit(code ?? failure);

    for (const forwarded of signals) process.off(forwarded, forward);
    process.kill(process.pid, signal);
  });
}

Promise.all([
  import("node:fs"),
  import("node:path"),
  import("node:module"),
  import("node:child_process"),
  import("node:util"),
]).then(([fs, path, { createRequire }, { spawn }, util]) => {
  const require = createRequire(fs.realpathSync(process.argv[1]));
  run(locate(fs, path, require), spawn, util);
});
